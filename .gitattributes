# Text files are stored and checked out with LF line endings on every platform, so a
# file's SHA-256 is the same on Windows, macOS, Linux and Kaggle. The run log records
# hashes of the split files; the integrity check also accepts CRLF copies made before
# this rule existed.
* text=auto eol=lf
*.pt binary
*.npz binary
*.png binary
*.jpeg binary
*.jpg binary

# Append-only JSON Lines logs (memos 0008 and 0013): when two branches both add records,
# keep the lines from both sides instead of reporting a conflict. The integrity check
# verifies afterwards that every run_id and analysis_id is still unique.
runs/*.jsonl merge=union
