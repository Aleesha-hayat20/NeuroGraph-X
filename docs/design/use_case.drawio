        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml NeuroGraphX_UseCase\nleft to right direction\nskinparam backgroundColor #FFFFFF\nskinparam actorStyle awesome\nskinparam usecase {\n  BackgroundColor&lt;&lt;core&gt;&gt; #9FE1CB\n  BorderColor&lt;&lt;core&gt;&gt; #0F6E56\n  BackgroundColor&lt;&lt;included&gt;&gt; #B5D4F4\n  BorderColor&lt;&lt;included&gt;&gt; #185FA5\n  BackgroundColor&lt;&lt;support&gt;&gt; #CECBF6\n  BorderColor&lt;&lt;support&gt;&gt; #534AB7\n  BackgroundColor&lt;&lt;future&gt;&gt; #FAC775\n  BorderColor&lt;&lt;future&gt;&gt; #854F0B\n}\n\nactor \&quot;Research User\&quot; as user\nactor \&quot;ABIDE Dataset\&quot; as abide\nactor \&quot;External Client\&quot; as client\nactor \&quot;System Integrator\&quot; as integrator\n\nrectangle \&quot;NeuroGraph-X\&quot; {\n\n  usecase \&quot;Select participant\&quot; as UC1 &lt;&lt;core&gt;&gt;\n  usecase \&quot;Choose atlas\&quot; as UC2 &lt;&lt;core&gt;&gt;\n  usecase \&quot;Run analysis\&quot; as UC3 &lt;&lt;core&gt;&gt;\n  usecase \&quot;View classification result\&quot; as UC4 &lt;&lt;core&gt;&gt;\n  usecase \&quot;Regenerate past result\&quot; as UC5 &lt;&lt;core&gt;&gt;\n\n  usecase \&quot;Validate and QC data\&quot; as UC3a &lt;&lt;included&gt;&gt;\n  usecase \&quot;Build brain graph\&quot; as UC3b &lt;&lt;included&gt;&gt;\n  usecase \&quot;Predict diagnosis\&quot; as UC3c &lt;&lt;included&gt;&gt;\n\n  usecase \&quot;View run history\&quot; as UC9 &lt;&lt;support&gt;&gt;\n  usecase \&quot;View exclusion log\&quot; as UC10 &lt;&lt;support&gt;&gt;\n  usecase \&quot;Query via REST API\&quot; as UC11 &lt;&lt;support&gt;&gt;\n  usecase \&quot;Deploy the system\&quot; as UC12 &lt;&lt;support&gt;&gt;\n  usecase \&quot;Check system health\&quot; as UC13 &lt;&lt;support&gt;&gt;\n\n  usecase \&quot;View driving brain regions\&quot; as UC6 &lt;&lt;future&gt;&gt;\n  usecase \&quot;View reliability range\&quot; as UC7 &lt;&lt;future&gt;&gt;\n  usecase \&quot;Export report\&quot; as UC8 &lt;&lt;future&gt;&gt;\n  usecase \&quot;Upload own connectivity data\&quot; as UC14 &lt;&lt;future&gt;&gt;\n}\n\nuser --&gt; UC1\nuser --&gt; UC2\nuser --&gt; UC3\nuser --&gt; UC4\nuser --&gt; UC5\nuser --&gt; UC9\nuser --&gt; UC10\nuser ..&gt; UC6\nuser ..&gt; UC7\nuser ..&gt; UC8\n\nabide --&gt; UC1\n\nclient --&gt; UC11\nclient --&gt; UC13\n\nintegrator --&gt; UC12\nintegrator --&gt; UC13\n\nUC3 ..&gt; UC3a : &lt;&lt;include&gt;&gt;\nUC3 ..&gt; UC3b : &lt;&lt;include&gt;&gt;\nUC3 ..&gt; UC3c : &lt;&lt;include&gt;&gt;\n\nnote right of UC14\n  Not promised for this\n  project; natural extension only\nend note\n\nnote bottom of UC6\n  FYP-II, planned\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_CgDyqwod5K6a0mIVyPx-33">
