        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Sequence Diagram: Run New Analysis\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam sequenceMessageAlign center\nskinparam ArrowColor #333333\nskinparam SequenceLifeLineBorderColor #555555\nskinparam ParticipantPadding 8\n\nactor \&quot;Research User\&quot; as U\nparticipant \&quot;Web Dashboard\\n(M7)\&quot; as M7\nparticipant \&quot;Model Service\\nREST API (M3)\&quot; as M3\nparticipant \&quot;Ingestion and QC\\n(M1)\&quot; as M1\nparticipant \&quot;Connectome Engine\\n(M2)\&quot; as M2\ndatabase \&quot;Model Registry\&quot; as MR\ndatabase \&quot;ROI Time Series\\nFiles (ABIDE)\&quot; as TS\ndatabase \&quot;Analysis Log\\n(planned)\&quot; as AL\n\nU -&gt; M7 ++ : open dashboard\nM7 -&gt; M3 ++ : request participant list\nM3 -&gt; M1 ++ : get participants with quality status\nM1 --&gt; M3 -- : participants, quality status, exclusion reasons\nM3 --&gt; M7 -- : participant list\nM7 --&gt; U : show research-use-only notice and participant list\n\nloop until an eligible participant is chosen\nU -&gt; M7 : select participant\nalt participant excluded by quality control\nM7 --&gt; U : show exclusion reason, Run stays disabled\nelse participant eligible\nM7 --&gt; U : show the four atlases\nend\nend\n\nU -&gt; M7 : choose atlas, click Run Analysis\nM7 -&gt; M3 ++ : analysis request (participant_id, atlas)\n\nM3 -&gt; MR ++ : get current model for atlas\nMR --&gt; M3 -- : run_id and checkpoint, or not found\nbreak no model registered for this atlas\nM3 --&gt; M7 : error: no model for this atlas\nM7 --&gt; U : show message, return to selection\nend\n\nM3 -&gt; M1 ++ : request data (participant_id, atlas)\nM1 -&gt; TS ++ : read ROI time series\nTS --&gt; M1 -- : time series, or file missing\nM1 -&gt; M1 : validate file (complete, expected regions)\nbreak file missing or invalid\nM1 --&gt; M3 : error with reason\nM3 --&gt; M7 : error: participant data unusable\nM7 --&gt; U : show reason, return to selection\nend\n\nM1 -&gt; M2 ++ : validated time series\ndeactivate M1\nM2 -&gt; M2 : load stored connection matrix, or compute it:\\ncorrelations, Fisher z-transform, no-signal rule (memo 0007),\\ndiagonal set to zero\nM2 -&gt; M3 -- : connection matrix\n\nM3 -&gt; M3 : build graph (keep strongest 10% of connections)\nbreak graph has invalid values\nM3 --&gt; M7 : error: invalid input for the model\nM7 --&gt; U : show message, return to selection\nend\nM3 -&gt; M3 : load checkpoint, run model:\\nprediction and confidence\nM3 -&gt; AL ++ : save analysis record\nAL --&gt; M3 -- : analysis_id\nM3 --&gt; M7 -- : participant_id, atlas, prediction,\\nconfidence, calibrated, run_id\nM7 --&gt; U : show classification and confidence\ndeactivate M7\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="a5uQJ0wkvQFUnSPq2Rom-72">
