        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n@startuml\ntitle Run New Analysis\nstart\n:Open NeuroGraph-X dashboard;\n:Display research-use-only notice;\n:Load ABIDE participant list with metadata;\n:Display participant list;\n:Filter list by group, site or age band;\nrepeat\n  :Select a participant;\n  :Display participant metadata and data quality summary;\nrepeat while (Participant excluded by quality control?) is ([Yes]) not ([No])\n:Display the four supported atlases;\n:Choose an atlas;\n:Click Run Analysis;\n:Show progress indicator;\n:Load precomputed ROI time series for participant and atlas;\n:Validate file completeness and format;\nif (Validation passed?) then ([Yes])\nelse ([No])\n  :Display validation error with reason;\n  stop\nendif\nif (Brain graph already cached?) then ([Yes])\n  :Load cached brain graph;\nelse ([No])\n  :Compute correlation between all region pairs;\n  :Apply Fisher z-transform;\n  :Set diagonal to zero;\n  :Store brain graph in cache;\nendif\n:Load trained model for chosen atlas;\n:Run forward pass on brain graph;\n:Apply calibration to confidence score;\n:Write run record to run log;\n:Display classification and calibrated confidence;\nfork\n  :Compute region and connection attribution;\n  :Map regions to anatomical names of chosen atlas;\n  :Display 3D brain view with driving regions highlighted;\n  :Explore brain view and inspect a region;\nfork again\n  :Run participant through variant models\\n(seed, sample, atlas, site);\n  :Compute spread of prediction and confidence per axis;\n  :Write variant run records to run log;\n  :Display reliability envelope;\nend fork\n:Review complete result;\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="xkBQifBud6o0e2CXM-Nb-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
