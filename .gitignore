# data: everything except the committed frozen split and .gitkeep files
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
!data/frozen/*.csv

# generated reports keep their figures tracked, drafts do not
docs/reports/*.html

# python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/
.coverage
htmlcov/

# environments
.venv/
venv/
env/
.python-version

# models and caches
models/
*.pt
*.pth
*.ckpt
.cache/
nilearn_data/

# editors and os
.vscode/
.idea/
.DS_Store
Thumbs.db

# secrets, never commit
.env
*.pem
*.key
runs/*.sqlite
node_modules/

# fixture dataset (memo 0014): its tiny checkpoint IS committed, unlike real checkpoints;
# analyses written while the API runs in fixture mode are not
!fixtures/checkpoints/*.pt
# the final model of each atlas and the CC200 baseline are committed, one line per file
# (memo 0009 option A, licence in checkpoints/README.md); other checkpoints stay local
!checkpoints/aal_57900b0d.pt
!checkpoints/cc200_cf60f29e.pt
!checkpoints/ho_76533df4.pt
!checkpoints/dosenbach160_5ee28510.pt
!checkpoints/cc200_00252f2b.pt
fixtures/runs/analysis_log.jsonl
fixtures/runs/*.sqlite
