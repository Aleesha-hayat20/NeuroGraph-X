# data: everything except the committed frozen split and .gitkeep files
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
!data/frozen/*.csv

# generated reports keep their figures tracked, drafts do not
docs/reports/*.html

# python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/
.coverage
htmlcov/

# environments
.venv/
venv/
env/
.python-version

# models and caches
models/
*.pt
*.pth
*.ckpt
.cache/
nilearn_data/

# editors and os
.vscode/
.idea/
.DS_Store
Thumbs.db

# secrets, never commit
.env
*.pem
*.key
runs/*.sqlite
node_modules/
